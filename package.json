    "next": "15.5.28",
    "node-cron": "4.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "prisma": "^5.21.1"
  },
  "engines": {
    "node": ">=22 <25"
  },
